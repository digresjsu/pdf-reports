<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_partner_view_form_ares" model="ir.ui.view">
        <field name="name">res.partner.view.form.ares</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="/form//div[@name='warning_tax']" position="before">
                <button name="action_fetch_from_ares"
                        string="Fetch from ARES"
                        type="object"
                        invisible="not vat"/>
            </xpath>
        </field>
    </record>
</odoo>
