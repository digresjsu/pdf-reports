<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="digres_record_change_tracker_list_view" model="ir.ui.view">
        <field name="name">digres.record.change.tracker.view.list</field>
        <field name="model">digres.record.change.tracker</field>
        <field name="arch" type="xml">
            <list string="Changes">
                <field name="res_model"/>
                <field name="res_id"/>
                <field name="field_name"/>
                <field name="old_value"/>
                <field name="new_value"/>
                <field name="changed_on"/>
                <field name="record_name"/>
            </list>
        </field>
    </record>

    <record id="digres_record_change_tracker_action" model="ir.actions.act_window">
        <field name="name">Record Change Tracker</field>
        <field name="res_model">digres.record.change.tracker</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem
        id="digres_record_change_tracker_menu"
        name="Record Change Tracker"
        action="digres_record_change_tracker_action"
        parent="digres_root_menu"
        sequence="10"/>

</odoo>
