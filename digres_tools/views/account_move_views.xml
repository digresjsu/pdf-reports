<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_move_form_inherit_account_move" model="ir.ui.view">
        <field name="name">account.move.form.digres.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='currency_conversion_div']/field[@name='currency_id']" position="after">
                <div name="inversed_currency_rate" class="d-flex gap-1 text-muted text-right">
                    <span>1 </span>
                    <field name="currency_id" readonly='1' options='{"no_open": True}' class="w-auto"/>
                    <span> = </span>
                    <field name="currency_rate_inverted" digits="[12,6]" readonly="1" nolabel="1" style="max-width: 21ch;"/>
                    <field name="company_currency_id" readonly="1" options="{'no_open': True}" class="w-auto"/>
                </div>
            </xpath>

            <xpath expr="//group[@id='header_left_group']/div" position="after">
                <field name="dph_term" class="w-auto"/>
            </xpath>
        </field>
    </record>

</odoo>