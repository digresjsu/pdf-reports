<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="digres_company_name_history_list_view" model="ir.ui.view">
        <field name="name">digres.company.name.history.view.list</field>
        <field name="model">digres.company.name.history</field>
        <field name="arch" type="xml">
            <list string="Company Name History" editable="bottom">
                <field name="partner_id"/>
                <field name="name"/>
                <field name="valid_from"/>
                <field name="valid_until"/>
            </list>
        </field>
    </record>

    <record id="digres_company_name_history_action" model="ir.actions.act_window">
        <field name="name">Company Name History</field>
        <field name="res_model">digres.company.name.history</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem
        id="digres_root_menu"
        name="Digres"
        action="digres_company_name_history_action"
        web_icon="digres_tools,static/description/menu_icon.png"
        sequence="10"/>
    
    <menuitem
        id="digres_company_name_history_menu"
        name="Company Name History"
        action="digres_company_name_history_action"
        parent="digres_root_menu"
        sequence="10"/>

</odoo>
